# Copy to .env, make it readable only by you, and choose your own password.
# Required only to create the first admin account; changing this value does not
# reset an existing account's password. The initial username is admin.
ADMIN_PASSWORD=

# Must exactly match the URL used in the browser, including a non-default port.
# Use an HTTPS origin when placing this service behind an HTTPS reverse proxy.
PUBLIC_ORIGIN=http://localhost:3000

# Safe local-only defaults. Change deliberately when exposing the service.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Override this to use a published image instead of the local build tag.
DINNER_SPLIT_IMAGE=dinner-split:1.1.3
